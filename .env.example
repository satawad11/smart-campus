# AI Smart Campus — development environment example.
# Copy to .env for local development:  cp .env.example .env
#
# These are DEV-ONLY placeholder values. Do NOT put production secrets here.
# The real .env file is gitignored and must never be committed.

# --- Nginx -------------------------------------------------------------------
NGINX_HTTP_PORT=80

# --- Frontend (Vue/Vite) -----------------------------------------------------
NODE_ENV=development

# --- PostgreSQL + pgvector ---------------------------------------------------
POSTGRES_DB=smart_campus
POSTGRES_USER=smart_campus
POSTGRES_PASSWORD=smart_campus
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Reverb / WebSocket ------------------------------------------------------
REVERB_PORT=8080

# --- AI service --------------------------------------------------------------
AI_MODE=mock
