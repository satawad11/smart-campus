# AI Smart Campus — development environment example.
# Copy to .env for local development:  cp .env.example .env
#
# These are DEV-ONLY placeholder values. Do NOT put production secrets here.
# The real .env file is gitignored and must never be committed.

# --- Nginx -------------------------------------------------------------------
NGINX_HTTP_PORT=80

# --- Frontend (Vue/Vite) -----------------------------------------------------
NODE_ENV=development

# --- PostgreSQL + pgvector ---------------------------------------------------
POSTGRES_DB=smart_campus
POSTGRES_USER=smart_campus
POSTGRES_PASSWORD=smart_campus
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- Object storage (SeaweedFS, S3-compatible) -------------------------------
OBJECTSTORE_ROOT_USER=campus-root
OBJECTSTORE_ROOT_PASSWORD=campus-dev-root-secret
OBJECTSTORE_PORT=8333

# --- Reverb / WebSocket ------------------------------------------------------
REVERB_PORT=8080
# Same value as REVERB_APP_KEY in apps/backend/.env (public; sent to the browser)
REVERB_APP_KEY=

# --- AI service --------------------------------------------------------------
AI_MODE=mock
