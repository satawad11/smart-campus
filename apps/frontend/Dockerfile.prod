# Frontend (Vue 3 + Vite) — production image (pilot pre-deployment).
#
# Builds the static bundle and serves it with nginx on :5173 (the port the
# gateway already proxies to), replacing the Vite dev server used by the
# development compose file. Used by docker-compose.pilot.yml.
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Public Reverb app key (not a secret: it is visible to every browser client).
ARG VITE_REVERB_APP_KEY
RUN test -n "$VITE_REVERB_APP_KEY" || (echo "VITE_REVERB_APP_KEY build arg is required" >&2; exit 1)
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 5173
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1:5173/ >/dev/null || exit 1
