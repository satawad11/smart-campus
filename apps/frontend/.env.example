# Frontend development environment example. Copy to .env for local use.
# No secrets here — these are public build-time values.

# Public API base URL (Nginx proxies /api/v1 to the backend in dev).
VITE_API_BASE_URL=/api/v1

# Realtime broadcasting (Laravel Reverb, EVT-016 Live Monitor). The Echo
# client (src/services/echo.js) connects to the page's own origin at
# /reverb — nginx proxies that to the backend's Reverb server — so only the
# public app key is needed here, mirroring apps/backend/.env.example's
# REVERB_APP_KEY (a public identifier like a Pusher app key, never the
# app secret).
VITE_REVERB_APP_KEY=
