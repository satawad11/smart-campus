<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:3SB2MH64iiFfhZmwKWeEHySCnZPuyTxuKSQUTtQ+tlo="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
        FACE-021 human-approved pilot recognition policy (docs/FACE-021-PILOT-THRESHOLDS-REVIEW.md).
        Explicit test-environment configuration only — config/face.php itself carries
        NO silent production fallback logic of its own beyond these same env() defaults,
        and tests that must verify the fail-closed path unset these values locally via
        config([...]) inside the test method (see Module03AcceptanceSecurityTest).
        -->
        <env name="FACE_RECOGNITION_MATCH_THRESHOLD" value="0.80"/>
        <env name="FACE_RECOGNITION_REVIEW_THRESHOLD" value="0.60"/>
        <env name="FACE_RECOGNITION_AMBIGUITY_MARGIN" value="0.05"/>
        <env name="FACE_DUPLICATE_REVIEW_SIMILARITY_THRESHOLD" value="0.65"/>
        <env name="FACE_LIVENESS_THRESHOLD_REAL" value="0.70"/>
        <env name="FACE_LIVENESS_THRESHOLD_SPOOF" value="0.40"/>
    </php>
</phpunit>
