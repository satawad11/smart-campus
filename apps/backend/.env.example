APP_NAME="Smart Campus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL (pgvector/pg_trgm extensions configured in FND-006) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smart_campus
DB_USERNAME=smart_campus
DB_PASSWORD=smart_campus

# --- Session / Cache / Queue backed by Redis ---
SESSION_DRIVER=redis
SESSION_COOKIE=laravel-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Realtime broadcasting (Laravel Reverb, EVT-013) ---
# REVERB_HOST is the backend's own PUBLISH-side address (server pushing an
# event INTO Reverb) — the `websocket` Docker Compose service name, not a
# browser-reachable host. A browser never talks to this directly: nginx
# proxies /reverb/ to it (infrastructure/nginx/default.conf), and the
# frontend's own VITE_REVERB_APP_KEY (apps/frontend/.env.example) is all it
# needs — pointing REVERB_HOST at `localhost` makes the backend try to
# reach itself instead of the websocket container.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=websocket
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3-compatible object storage (MinIO) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
# Default s3 disk: probed by /health/storage (FND-010). Must be a provisioned bucket
# from infrastructure/minio/buckets.txt (PILOT-001).
AWS_BUCKET=face-samples
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Per-bucket names (development blueprint §8). Disks defined in config/filesystems.php.
S3_BUCKET_PERSON_PHOTOS=person-photos
S3_BUCKET_FACE_SAMPLES=face-samples
S3_BUCKET_EVENT_SNAPSHOTS=event-snapshots
S3_BUCKET_REPORT_EXPORTS=report-exports

# --- Internal AI service (used by backend health checks; FND-010) ---
AI_SERVICE_URL=http://ai-service:8001

# --- Locked V1 feature kill switches (SEC-024 condition 1; config/features.php) ---
# Must stay explicitly false in production. `php artisan pilot:preflight` fails otherwise.
FEATURE_DOOR_ENABLED=false
FEATURE_VISITOR_ENABLED=false
FEATURE_VEHICLE_ENABLED=false
FEATURE_ALPR_ENABLED=false
FEATURE_AI_ASSISTANT_ENABLED=false

# --- Commercial license (COM-02; docs/commercial/LICENSE_MODEL.md) ---
# off | warn (default: report and alert, never block) | enforce (refuse growth beyond the license)
LICENSE_ENFORCEMENT=warn
LICENSE_EXPIRY_WARNING_DAYS=30

# --- General /api/v1 rate limit per user (or IP), per minute (security baseline) ---
API_RATE_LIMIT_PER_MINUTE=300
# Roles that must enrol MFA when System Settings > Security > security.admin_mfa_enforced is on (off by default)
AUTH_MFA_REQUIRED_ROLES=SUPER_ADMIN,SYSTEM_ADMIN

# --- Backup encryption (PDPA G-4): `php artisan backup:key`; keep the key in a vault, apart from backups ---
BACKUP_ENCRYPTION_KEY=
# Alert when the storage volume has less free space than this (percent)
SERVER_DISK_MIN_FREE_PERCENT=10

VITE_APP_NAME="${APP_NAME}"
