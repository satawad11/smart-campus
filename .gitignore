# --- OS / editor cruft -------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# --- Secrets / local env (never commit) --------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# scripts/tls-setup.sh working directories (CA, Let's Encrypt state, ACME webroot)
infrastructure/pilot/ca/
infrastructure/pilot/letsencrypt/
infrastructure/pilot/acme/
# AI node: trusted backend CA copied onto the node
deploy/ai-node/certs/
# License signing keys (tools/license-issuer) and issued customer licenses
*.secret
*.lic

# --- Dependency / build output (reserved for later FND tasks) ----------------
node_modules/
vendor/
dist/
build/
__pycache__/
*.pyc
.venv/

# Keep intentionally-empty directories tracked via their placeholders.
!**/.gitkeep

# scripts/upgrade-campus.sh run record (host-local)
.upgrade-state

# Face models fetched by scripts/fetch-face-models.sh (ACR-AI-01); not committed
apps/ai-service/models/
