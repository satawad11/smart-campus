# =============================================================================
# Smart Campus — PILOT environment template
#
# Copy to apps/backend/.env ON THE PILOT HOST ONLY (never commit the copy):
#   cp infrastructure/pilot/pilot.env.example apps/backend/.env && chmod 600 apps/backend/.env
# It is read by Laravel (env_file) and by docker compose (--env-file).
#
# Every value left empty below MUST be filled. Compose refuses to start
# (${VAR:?}) and `php artisan pilot:preflight` fails while required secrets
# are empty or still development defaults. Generate secrets with e.g.
#   openssl rand -hex 24
# APP_KEY: docker compose run --rm backend php artisan key:generate --show
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Smart Campus"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://pilot.example.invalid
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Gateway -----------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CORS_ALLOWED_ORIGINS=https://pilot.example.invalid

# --- PostgreSQL --------------------------------------------------------------
# Owner/superuser used only by the postgres container, db-roles setup and restores.
POSTGRES_DB=smart_campus
POSTGRES_USER=campus_owner
POSTGRES_PASSWORD=
# Runtime application role (SEC-005, least privilege: DML only)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smart_campus
DB_USERNAME=campus_app_user
DB_PASSWORD=
# Other SEC-005 roles (created by: docker compose ... run --rm db-roles)
MIGRATION_DB_PASSWORD=
MONITORING_DB_PASSWORD=
BACKUP_DB_USERNAME=campus_backup_user
BACKUP_DB_PASSWORD=

# --- Redis (password required; not published outside the host network) -------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_DRIVER=redis
SESSION_COOKIE=laravel-session
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Reverb (WebSocket, served as wss://<host>/reverb via the gateway) -------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=websocket
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Object storage (SeaweedFS, S3-compatible) -------------------------------
# Root (admin) identity: used only by the objectstore container and the
# one-off storage-migrate job. Never given to the application.
OBJECTSTORE_ROOT_USER=
OBJECTSTORE_ROOT_PASSWORD=
# Application credentials: least-privilege identity generated by
# infrastructure/objectstore/start.sh with access to the four application
# buckets only (no bucket creation, no admin). Never the root identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=face-samples
AWS_ENDPOINT=http://objectstore:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
S3_BUCKET_PERSON_PHOTOS=person-photos
S3_BUCKET_FACE_SAMPLES=face-samples
S3_BUCKET_EVENT_SNAPSHOTS=event-snapshots
S3_BUCKET_REPORT_EXPORTS=report-exports

# --- AI service --------------------------------------------------------------
AI_SERVICE_URL=http://ai-service:8001
# REQUIRED HUMAN DECISION (PILOT-000 B5): the repository ships no production
# detection/embedding/PAD models. `mock` is NOT real recognition; `onnx` needs
# model files that are not provided. Leave empty until decided — compose
# refuses to start without it.
AI_MODE=

# --- Locked V1 features (SEC-024 condition 1) — must stay false --------------
FEATURE_DOOR_ENABLED=false
FEATURE_VISITOR_ENABLED=false
FEATURE_VEHICLE_ENABLED=false
FEATURE_ALPR_ENABLED=false
FEATURE_AI_ASSISTANT_ENABLED=false

# --- Commercial license (COM-02; docs/commercial/LICENSE_MODEL.md) ---
# off | warn (default: report and alert, never block) | enforce (refuse growth beyond the license)
LICENSE_ENFORCEMENT=warn
LICENSE_EXPIRY_WARNING_DAYS=30

# --- General /api/v1 rate limit per user (or IP), per minute (security baseline) ---
API_RATE_LIMIT_PER_MINUTE=300
# Roles that must enrol MFA when System Settings > Security > security.admin_mfa_enforced is on (off by default)
AUTH_MFA_REQUIRED_ROLES=SUPER_ADMIN,SYSTEM_ADMIN

# --- Backup encryption (PDPA G-4): `php artisan backup:key`; keep the key in a vault, apart from backups ---
BACKUP_ENCRYPTION_KEY=
# Alert when the storage volume has less free space than this (percent)
SERVER_DISK_MIN_FREE_PERCENT=10

# --- Backups (docs/pilot/PILOT-BACKUP-RETENTION-POLICY.md) -------------------
# Values are PROPOSED defaults: AWAITING HUMAN RETENTION APPROVAL.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_DATABASE_CRON="*/10 * * * *"
BACKUP_STORAGE_CRON="5 * * * *"
BACKUP_PRUNE_CRON="30 3 * * *"
BACKUP_RETENTION_RECENT_HOURS=48
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_MIN_VERIFIED=3
# Host path of the off-host backup mount (NFS/SMB/removable volume on a
# different machine or disk), mounted at /var/backups/offhost in the containers.
BACKUP_OFFHOST_HOST_PATH=
BACKUP_OFFHOST_PATH=/var/backups/offhost

# --- Fail-fast timeouts (V1 audit A-10/A-11) --------------------------------
DB_CONNECT_TIMEOUT=5
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=2
# Scheduler overlap locks (database store keeps backups/monitoring alive during a Redis outage)
SCHEDULE_CACHE_STORE=database
# Login throttle per minute (in addition to account lockout)
AUTH_LOGIN_THROTTLE_PER_IP=30
AUTH_LOGIN_THROTTLE_PER_ACCOUNT_IP=10

# --- Monitoring thresholds ---------------------------------------------------
AI_NODE_STALE_AFTER_SECONDS=90
CAMERA_STALE_AFTER_SECONDS=120
QUEUE_BACKLOG_ALERT_THRESHOLD=1000

# --- Mail (alerts are dashboard-only in V1; see PILOT-008 §2.3) --------------
MAIL_MAILER=log

# Upload malware scan (docs/commercial/SECURITY_BASELINE.md). The pilot overlay
# runs the clamav service; uploads are refused (503) while it is unavailable.
UPLOAD_SCAN_DRIVER=clamav
UPLOAD_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
