{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppBucketsList",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::person-photos",
        "arn:aws:s3:::face-samples",
        "arn:aws:s3:::event-snapshots",
        "arn:aws:s3:::report-exports"
      ]
    },
    {
      "Sid": "AppBucketsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::person-photos/*",
        "arn:aws:s3:::face-samples/*",
        "arn:aws:s3:::event-snapshots/*",
        "arn:aws:s3:::report-exports/*"
      ]
    }
  ]
}
